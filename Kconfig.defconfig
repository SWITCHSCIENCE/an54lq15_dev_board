config HW_STACK_PROTECTION
	default ARCH_HAS_STACK_PROTECTION

if BOARD_SSCI_AN54LQ15_DEV_BOARD_NRF54L15_CPUAPP

config ROM_START_OFFSET
	default 0x800 if BOOTLOADER_MCUBOOT

endif # BOARD_SSCI_AN54LQ15_DEV_BOARD_NRF54L15_CPUAPP

if BOARD_SSCI_AN54LQ15_DEV_BOARD_NRF54L15_CPUAPP_NS

config BOARD_SSCI_AN54LQ15_DEV_BOARD
	select USE_DT_CODE_PARTITION if BOARD_SSCI_AN54LQ15_DEV_BOARD_NRF54L15_CPUAPP_NS

config HAS_BT_CTLR
	default BT

# By default, if we build for a Non-Secure version of the board,
# enable building with TF-M as the Secure Execution Environment.
config BUILD_WITH_TFM
	default y

endif # BOARD_SSCI_AN54LQ15_DEV_BOARD_NRF54L15_CPUAPP_NS
